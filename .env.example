# =====================================================================
# LA NOTICIA SIN FILTRO · Variables de entorno
#
# Copia este archivo como .env y rellena los valores reales.
# .env NUNCA se sube al repositorio. Nunca escribas credenciales aqui.
# =====================================================================

APP_NAME="La Noticia SIN FILTRO"
APP_ENV=produccion              # local | produccion
APP_DEBUG=false                 # true SOLO en local. Jamas en produccion.
APP_URL=https://lanoticia.sinfiltroconmax.com
APP_TIMEZONE=America/Caracas

# Sal del servidor para huellas anonimas del Pulso.
# Genera una con: php -r "echo bin2hex(random_bytes(32));"
APP_KEY=

# --- Base de datos ---------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# --- Sesion y seguridad ----------------------------------------------
SESSION_NAME=lnsf_sesion
SESSION_SECURE_COOKIES=true     # true cuando el sitio corre bajo HTTPS
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# --- Medios ----------------------------------------------------------
UPLOAD_MAX_IMAGE_MB=8
UPLOAD_MAX_VIDEO_MB=200
UPLOAD_MAX_DOCUMENT_MB=25

# --- Marca y redes ---------------------------------------------------
BRAND_NAME="SIN FILTRO con Max"
BRAND_INSTAGRAM=sinfiltroconmax
BRAND_INSTAGRAM_PERSONAL=maxegonzalezp
BRAND_TIKTOK=sinfiltroconmax
EDITORIAL_EMAIL=

# --- Portada ---------------------------------------------------------
HERO_VIDEO_ENABLED=true
HERO_VIDEO_PATH=/assets/video/hero-scrub.mp4
HERO_VIDEO_WEBM_PATH=/assets/video/hero-scrub.webm
HERO_POSTER_PATH=/assets/images/hero-poster.jpg
HERO_ENDING_PATH=/assets/images/hero-final.jpg

# --- Contenido de demostracion ---------------------------------------
# Con true, las piezas marcadas is_demo muestran un aviso visible.
SHOW_DEMO_BADGE=true
