# =====================================================================
# CREDISAN CONTROL MULTISEDE · Variables de entorno
# =====================================================================
# Copie a .env y complete. .env NUNCA se sube al repositorio.

# ── Público (viaja al navegador; es correcto que sea visible) ─────────
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
APP_BASE_URL=https://control.sinfiltroconmax.com

# ── Secreto (SÓLO en Edge Functions / servidor. Jamás en el frontend) ─
# Anula toda la seguridad de RLS si se filtra.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Pimienta del PIN. No se guarda en la base de datos: sin ella, un volcado
# completo de PostgreSQL no permite recuperar ni verificar ningún PIN.
# Genere con: openssl rand -base64 48
# CAMBIARLA OBLIGA A REGENERAR TODOS LOS PIN.
CREDISAN_PIN_PEPPER=

# Par de claves para el modo offline (libsodium sealed box).
# El terminal sólo recibe la pública: cifra el PIN que teclea el trabajador
# durante el corte y NO puede volver a leerlo. La privada vive únicamente
# en la Edge Function que sincroniza.
# Genere con: deno run supabase/functions/_shared/keygen.ts
CREDISAN_OFFLINE_PUBLIC_KEY=
CREDISAN_OFFLINE_PRIVATE_KEY=
